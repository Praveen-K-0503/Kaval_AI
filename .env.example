# KaavalAI KSP — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Environment Mode ──────────────────────────────────────────────────────
# "local"      → Use SQLite (local development, no Catalyst needed)
# "production" → Use Catalyst Data Store (deployed on AppSail)
CATALYST_ENV=local

# ── Zoho Catalyst Project Credentials ─────────────────────────────────────
# Get these from: Catalyst Console → Settings → App Settings
CATALYST_PROJECT_ID=YOUR_PROJECT_ID_HERE
CATALYST_PROJECT_KEY=YOUR_PROJECT_KEY_HERE

# ── Zoho Catalyst User Details ────────────────────────────────────────────
CATALYST_USER_ID=60078521867
CATALYST_USER_EMAIL=praveen0503k@gmail.com

# ── Frontend API URL ──────────────────────────────────────────────────────
# Local dev
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Catalyst AppSail URL — fill after deployment)
# NEXT_PUBLIC_API_URL=https://kaavalai-ksp.catalyst.zoho.com

# ── Catalyst Services Configuration ──────────────────────────────────────
CATALYST_MAIL_FROM=kaavalai-alerts@ksp-datathon.in
CATALYST_MAIL_TO=sp.bengaluru@ksp-datathon.in

# ── App Configuration ─────────────────────────────────────────────────────
APP_NAME=KaavalAI KSP Intelligence Platform
APP_VERSION=2.0.0
CORS_ORIGINS=http://localhost:3000,https://kaavalai-ksp.catalyst.zoho.com
